+/* A private probe freezes numeric UDP peer tuples before creating streams.
+ * An explicitly empty list denies all peers. NULL means ordinary ICE. */
+gboolean
+agent_probe_peer_allowed (NiceAgent *agent, const NiceAddress *address)
+{
+  guint i;
+  if (agent->probe_peer_addresses == NULL)
+    return TRUE;
+  if (address == NULL)
+    return FALSE;
+  for (i = 0; i < agent->probe_peer_addresses->len; ++i) {
+    NiceAddress *allowed = &g_array_index (agent->probe_peer_addresses, NiceAddress, i);
+    if (nice_address_equal (allowed, address))
+      return TRUE;
+  }
+  return FALSE;
+}
+
+static void
+set_probe_peer_allowlist (NiceAgent *agent, gchar **values)
+{
+  GArray *addresses;
+  guint i;
+  if (values == NULL || agent->streams != NULL || agent->pruning_streams != NULL ||
+      agent->probe_peer_addresses != NULL) {
+    g_warning ("Probe peer allowlist must be set once before creating streams");
+    return;
+  }
+  addresses = g_array_new (FALSE, FALSE, sizeof (NiceAddress));
+  for (i = 0; values[i] != NULL; ++i) {
+    const gchar *separator = strrchr (values[i], '|');
+    const gchar *number;
+    gchar *host, *end;
+    guint64 port;
+    NiceAddress address;
+    if (separator == NULL || separator == values[i] || separator[1] == '\0')
+      goto invalid;
+    for (number = separator + 1; *number; ++number) {
+      if (*number < '0' || *number > '9')
+        goto invalid;
+    }
+    port = g_ascii_strtoull (separator + 1, &end, 10);
+    if (*end || port == 0 || port > 65535)
+      goto invalid;
+    host = g_strndup (values[i], separator - values[i]);
+    nice_address_init (&address);
+    if (!nice_address_set_from_string (&address, host)) {
+      g_free (host);
+      goto invalid;
+    }
+    g_free (host);
+    nice_address_set_port (&address, (guint) port);
+    g_array_append_val (addresses, address);
+  }
+  agent->probe_peer_addresses = addresses;
+  agent->probe_peer_allowlist = g_strdupv (values);
+  agent->use_ice_tcp = FALSE;
+  return;
+invalid:
+  g_array_unref (addresses);
+  g_warning ("Probe peer allowlist requires numeric address|UDP-port tuples");
 }
 
