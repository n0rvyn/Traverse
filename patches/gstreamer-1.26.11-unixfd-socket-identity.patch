+/* Only retire the filesystem node created by this listener. A caller can
+ * rename/rebind the requested path while the stream is running. Keep the
+ * socket alive through this check so its inode cannot be reused. */
+static void
+clear_bound_socket_path (GstUnixFdSink * self)
+{
+  GStatBuf current;
+
+  if (self->bound_socket_path == NULL)
+    return;
+
+  if (g_lstat (self->bound_socket_path, &current) == 0 &&
+      S_ISSOCK (current.st_mode) &&
+      current.st_dev == self->bound_socket_identity.st_dev &&
+      current.st_ino == self->bound_socket_identity.st_ino &&
+      current.st_uid == self->bound_socket_identity.st_uid)
+    g_unlink (self->bound_socket_path);
+
+  g_clear_pointer (&self->bound_socket_path, g_free);
+}
